{
  "name": "@webwriter/evolution-sim",
  "version": "0.0.0",
  "description": "Simulate evolution with agents that search for food, reproduce and pass on mutating genes. Inspect individual agents and analyze population and gene distribution in charts.",
  "keywords": [
    "webwriter-widget",
    "widget-lang-en",
    "widget-simulational",
    "isced2011-2",
    "isced2011-3",
    "iscedf2013-05",
    "evolution",
    "genetics"
  ],
  "repository": "github:webwriter-app/evolution-sim",
  "license": "MIT",
  "author": "Manuel Frohn (D4rkr34lm)",
  "scripts": {
    "clean": "rm -rf dist && rm -rf node_modules",
    "prepublishOnly": "npx @webwriter/build",
    "localize": "lit-localize extract && @webwriter/build localize && lit-localize build",
    "dev": "npx @webwriter/build dev",
    "test": "vitest"
  },
  "dependencies": {
    "@ghchinoy/litflow": "^0.5.2",
    "@lit-labs/signals": "^0.2.0",
    "@lit/context": "^1.1.6",
    "@lit/localize": "^0.12.2",
    "@shoelace-style/shoelace": "^2.20.1",
    "@webwriter/lit": "^2.2.0",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "comlink": "^4.4.2",
    "lit": "^3.3.3",
    "lodash-es": "^4.18.1",
    "neverthrow": "^8.2.0",
    "pixi.js": "^8.22.0",
    "seedrandom": "^3.0.5",
    "signal-utils": "^0.21.1",
    "uid": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lit/localize-tools": "^0.8.2",
    "@types/lodash-es": "^4.17.12",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "exports": {
    "./widgets/webwriter-evolution-sim.*": {
      "source": "./src/widgets/webwriter-evolution-sim.ts",
      "default": "./src/dist/widgets/webwriter-evolution-sim.*"
    },
    "./snippets/island-evolution.html": "./src/snippets/island-evolution.html",
    "./icon": "./icon.svg",
    "./custom-elements.json": "./custom-elements.json"
  },
  "customElements": "custom-elements.json"
}